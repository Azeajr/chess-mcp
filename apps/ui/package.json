{
  "name": "@chess-mcp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "predev:host": "node scripts/copy-engine.mjs",
    "dev:host": "vite --host",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "vite build",
    "postbuild": "node scripts/check-worker-boundary.mjs",
    "test:chat": "node --no-experimental-webstorage --import tsx --test test/*.test.ts",
    "test:e2e": "node ../../scripts/playwright-low-impact.mjs",
    "test:e2e:host": "E2E_CPU_QUOTA=60% E2E_RUNTIME_MAX=45min node ../../scripts/playwright-low-impact.mjs --project=chromium --project=firefox",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chess-mcp/chess-tools": "workspace:*",
    "chessground": "^9.1.1",
    "chessops": "^0.14.2",
    "solid-js": "^1.9.3",
    "stockfish": "^18.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
