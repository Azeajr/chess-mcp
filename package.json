{
  "name": "chess-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Chess repertoire UI + Node MCP server (TypeScript).",
  "scripts": {
    "dev": "pnpm --filter @chess-mcp/ui dev",
    "dev:host": "pnpm --filter @chess-mcp/ui dev:host",
    "mcp": "tsx apps/mcp-server/src/index.ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:strategic-fit": "pnpm --filter @chess-mcp/chess-tools exec tsc -p test/strategic-fit/tsconfig.json && tsx --test packages/chess-tools/test/strategic-fit/*.test.ts",
    "bench:strategic-fit": "pnpm --filter @chess-mcp/chess-tools build && node scripts/strategic-fit-benchmark.mjs",
    "check:tool-contract": "pnpm --filter @chess-mcp/chess-tools build && node --import tsx scripts/tool-contract-inventory.mjs && node scripts/tool-contract-semantics.mjs",
    "check:content": "node --import tsx scripts/check-content.mjs",
    "check:legacy-imports": "node scripts/check-legacy-imports.mjs",
    "ux:task": "node scripts/ux-task.mjs",
    "ux:test": "node scripts/ux-test.mjs",
    "ux:plan-check": "node scripts/ux-plan-check.mjs",
    "test:e2e": "node scripts/playwright-low-impact.mjs",
    "test:e2e:container": "node scripts/playwright-container.mjs",
    "test:e2e:update-snapshots": "node scripts/playwright-container.mjs --update-snapshots",
    "verify:openrouter": "node --import tsx scripts/openrouter-tool-surface-eval.mjs",
    "docs:generate": "pnpm --filter @chess-mcp/chess-tools build && node scripts/tool-catalog.mjs",
    "docs:check": "pnpm --filter @chess-mcp/chess-tools build && node scripts/tool-catalog.mjs --check && node scripts/docs-consistency.mjs",
    "sync:skills": "pnpm --filter @chess-mcp/chess-tools build && node scripts/workflow-guidance.mjs && rm -rf plugin/skills && cp -r .claude/skills plugin/skills",
    "check:skills": "pnpm --filter @chess-mcp/chess-tools build && node scripts/workflow-guidance.mjs --check && diff -r .claude/skills plugin/skills"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.8.0",
    "oxfmt": "^0.61.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.3.0"
}
